# Maintainer: Krishna Kumar <https://github.com/krishnakumar5757/spaceware>

pkgname=spacewise
pkgver=0.1.0
pkgrel=1
pkgdesc="Modern disk usage analyzer and selective cleanup desktop utility"
arch=('x86_64')
url="https://github.com/krishnakumar5757/spaceware"
license=('MIT')

# Runtime dependencies identified via direct ldd inspection of the compiled binary
depends=(
  'webkit2gtk-4.1'     # WebKit rendering engine & JavaScriptCore IPC
  'gtk3'               # GTK3 windowing and display backend
  'cairo'              # 2D vector graphics rendering
  'libsoup3'           # HTTP and networking stack for WebKitGTK
  'gdk-pixbuf2'        # Image and icon decoding
  'glib2'              # Core GObject, GIO, and GLib system abstractions
  'glibc'              # GNU C Library (POSIX statvfs system calls)
  'gcc-libs'           # GCC runtime library support
  'hicolor-icon-theme' # Standard XDG icon theme directory structure
)

# Build dependencies required to compile the Vite/TypeScript frontend and Rust backend
makedepends=(
  'cargo'  # Rust build driver
  'rust'   # Rust compiler toolchain
  'nodejs' # JavaScript engine for Vite frontend build
  'npm'    # Package manager for frontend dependencies
)

# SOURCE AND CHECKSUM LIMITATIONS (LOCAL PRE-RELEASE STAGE):
# An official Git release tag (e.g. v0.1.0) has not yet been tagged or published
# on GitHub (https://github.com/krishnakumar5757/spaceware).
#
# To avoid fabricating fake tarball URLs or placeholder checksums, this PKGBUILD
# builds from the local repository working tree snapshot (${startdir}/../..).
#
# UPSTREAM DISTRIBUTION NOTE:
# Once the upstream tag v0.1.0 is published on GitHub, update source and sha256sums to:
#   source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
#           "spacewise.desktop")
#   sha256sums=('<actual_github_tarball_sha256>'
#               'ce3c2813e70fb5481b32f45bd87282abc63b3b3ba51e686d52b2ec41f6fd42ae')
source=("spacewise.desktop")
sha256sums=('ce3c2813e70fb5481b32f45bd87282abc63b3b3ba51e686d52b2ec41f6fd42ae')

prepare() {
  local _srcroot
  _srcroot="$(cd "${startdir}/../.." && pwd -P)"

  # Prepare a clean build tree inside $srcdir
  cd "$srcdir"
  rm -rf "$pkgname-$pkgver"
  mkdir -p "$pkgname-$pkgver"

  # Snapshot the repository source files, excluding build artifacts and version control
  tar --exclude='./src-tauri/target' \
      --exclude='./node_modules' \
      --exclude='./dist' \
      --exclude='./.git' \
      --exclude='./.vscode' \
      --exclude='./packaging' \
      -cf - -C "$_srcroot" . | tar -xf - -C "$pkgname-$pkgver"

  cd "$pkgname-$pkgver"

  # Step 1: Install frontend dependencies from lockfile
  npm ci

  # Step 2: Fetch and verify Rust dependencies
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml
}

build() {
  cd "$srcdir/$pkgname-$pkgver"

  # Step 1: Build production frontend assets into dist/
  npm run build

  # Step 2: Build native Rust binary in release mode with embedded frontend assets
  # tauri_build in build.rs embeds frontendDist (../dist) directly into the binary
  cargo build --frozen --release --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  
  # 1. Native Executable
  install -Dm755 "src-tauri/target/release/spacewise" "$pkgdir/usr/bin/spacewise"
  
  # 2. XDG Desktop Entry
  install -Dm644 "$srcdir/spacewise.desktop" "$pkgdir/usr/share/applications/spacewise.desktop"
  
  # 3. Hicolor Icons (verified dimensions in src-tauri/icons/)
  install -Dm644 "src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/spacewise.png"
  install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/spacewise.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/spacewise.png"
  install -Dm644 "src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/spacewise.png"
  
  # 4. MIT License (required by Arch Linux packaging guidelines for MIT)
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
